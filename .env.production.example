# ==============================================================================
# Adatya Production Environment Variables (.env.production.example)
#
# Copy this file to '.env' on your production server:
#   cp .env.production.example .env
# ==============================================================================

# --- Server & Port Settings ---
PORT=8080
WEB_PORT=80

# --- Frontend Settings ---
# In production with Nginx reverse proxy, API requests go to /api
VITE_API_URL=/api

# --- Database Settings (PostgreSQL) ---
POSTGRES_DB=adatya_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_very_secure_db_password_123

# --- Database Connection URL ---
# Docker Compose internal network service name:
DB_URL=jdbc:postgresql://database:5432/adatya_db

# AWS RDS PostgreSQL example:
# DB_URL=jdbc:postgresql://adatya-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/adatya_db

# Database Connection Pool (HikariCP)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Hibernate DDL Auto: 'update' for schema auto-evolution
HIBERNATE_DDL_AUTO=update

# --- Security & CORS ---
# Comma-separated allowed frontend origins (No trailing slash)
CORS_ALLOWED_ORIGINS=https://adatya.yourdomain.com,http://localhost,http://localhost:80

# --- Default Seeded Admin Credentials ---
DEFAULT_ADMIN_MOBILE=9356893989
DEFAULT_ADMIN_PASSWORD=replace_with_a_secure_admin_password
