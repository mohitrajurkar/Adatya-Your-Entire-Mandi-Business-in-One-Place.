# ==========================================
# Adatya Production Environment Variables
# ==========================================

# --- Server & Port Settings ---
PORT=8080
WEB_PORT=80
POSTGRES_PORT=5432

# --- Frontend Settings ---
# URL of your deployed Spring Boot API (keep /api when using Nginx reverse proxy)
VITE_API_URL=/api

# --- Database Settings (PostgreSQL) ---
POSTGRES_DB=adatya_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_very_secure_db_password_123

# Database Connection URL (for standalone or external DB)
# In Docker Compose, this defaults automatically to jdbc:postgresql://postgres:5432/adatya_db
DB_URL=jdbc:postgresql://postgres:5432/adatya_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_very_secure_db_password_123

# Database Connection Pool (HikariCP)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Hibernate DDL Auto: 'update' for automatic schema evolution, 'validate' for strict DBAs
HIBERNATE_DDL_AUTO=update

# --- Security & CORS ---
# Comma-separated allowed frontend origins (No trailing slash)
CORS_ALLOWED_ORIGINS=https://adatya.yourdomain.com,http://localhost,http://localhost:80

# Default Seeded Admin Credentials (First launch only)
DEFAULT_ADMIN_MOBILE=replace_with_your_10_digit_mobile
DEFAULT_ADMIN_PASSWORD=replace_with_a_secure_admin_password

