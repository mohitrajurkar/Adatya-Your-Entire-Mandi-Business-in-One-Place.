# ==============================================================================
# Adatya Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in secure values for all required variables below.
# 3. DO NOT commit your real '.env' file to Git! (.gitignore already ignores it).
# ==============================================================================

# ------------------------------------------------------------------------------
# Web Server & Ports
# ------------------------------------------------------------------------------
# Port mapped on the host machine for the Nginx web server (Default: 80)
WEB_PORT=80

# ------------------------------------------------------------------------------
# Database Settings (Local Docker PostgreSQL)
# ------------------------------------------------------------------------------
# Database name
POSTGRES_DB=adatya_db

# Database username (defaults to 'postgres')
DB_USERNAME=postgres

# Database password (REQUIRED: replace with a strong, random password)
DB_PASSWORD=replace_with_a_secure_database_password

# ------------------------------------------------------------------------------
# Database Connection (Switching between Docker Compose and AWS RDS)
# ------------------------------------------------------------------------------
# Default when running all containers via Docker Compose:
DB_URL=jdbc:postgresql://database:5432/adatya_db

# When using AWS RDS PostgreSQL instead of containerized DB:
# 1. Comment out the DB_URL above and uncomment the RDS line below.
# 2. Replace <rds-endpoint> with your actual AWS RDS endpoint hostname.
# DB_URL=jdbc:postgresql://<rds-endpoint>.rds.amazonaws.com:5432/adatya_db

# Hibernate schema strategy: 'update' automatically updates tables; 'validate' verifies schema only
HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# Initial Administrator Account (Seeded on first startup)
# ------------------------------------------------------------------------------
# Primary mobile number used for Admin login
DEFAULT_ADMIN_MOBILE=9356893989

# Default administrator password (REQUIRED: Set your secure initial password)
DEFAULT_ADMIN_PASSWORD=replace_with_a_secure_admin_password

# ------------------------------------------------------------------------------
# Security & CORS Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. http://your-domain.com or http://your-ec2-ip)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
